# Auto detect text files and perform LF normalization
* text=auto

# Batch scripts MUST always use CRLF line endings on Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Python and configs
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.example text eol=lf
