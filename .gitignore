# ==============================================================================
# CHATBOX 2.0 — .GITIGNORE
# Loại trừ các file môi trường ảo, file tạm, cache và dữ liệu riêng biệt của máy
# ==============================================================================

# 1. Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# 2. Virtual Environments (Môi trường ảo Python - Nhiều GB, máy mới tự tạo)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 3. Thư mục Scratch & Dữ liệu cache thử nghiệm
scratch/
temp_test_*/
cached_embs.pkl
*.log
*.tmp
.env

# 4. Kiểm thử & Coverage
.pytest_cache/
.coverage
htmlcov/

# 5. Dữ liệu Knowledge Base & Tệp nguồn
data/*
!data/raw/
!data/raw/.gitkeep
!data/raw/dictionary_en_vi.db
!data/raw/du_lieu_tu_vung_chuan_trinh_do.xlsx
!data/raw/The_Oxford_3000_by_CEFR_level.pdf
data/raw/*
!data/raw/.gitkeep
!data/raw/dictionary_en_vi.db
!data/raw/du_lieu_tu_vung_chuan_trinh_do.xlsx
!data/raw/The_Oxford_3000_by_CEFR_level.pdf
!data/processed/
!data/processed/.gitkeep
!data/processed/qa_records.jsonl
!data/processed/sources_manifest.json
data/processed/*
!data/processed/.gitkeep
!data/processed/qa_records.jsonl
!data/processed/sources_manifest.json
data/app_data.db*
data/vocab_notebook.db*
data/*.db-wal
data/*.db-shm
storage/

# 6. Cơ sở dữ liệu Vector cục bộ
chroma_db/

# 7. Thư mục repo tham khảo cũ (Đã tích hợp trọn vẹn vào src/)
rag-chatbot-main/

# 8. Cấu hình cục bộ IDE & Hệ điều hành
.vscode/settings.json
.vscode/*.log
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# 9. Frontend Dependencies & Build Cục bộ
vocab_frontend/node_modules/
vocab_frontend/dist/
vocab_frontend/dist-ssr/
vocab_frontend/*.local
