# ==============================================================================
# CHATBOX 2.0 — BIẾN MÔI TRƯỜNG MẪU (OPTIONAL ENVIRONMENT VARIABLES)
# Sao chép tệp này thành .env nếu muốn tùy chỉnh cấu hình mặc định
# ==============================================================================

# Cấu hình Ollama Cục bộ (Localhost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=60.0
LLM_TEMPERATURE=0.1
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024
OLLAMA_NUM_THREAD=4

# Cấu hình Mô hình NLP & Transformers
PHOBERT_MODEL_NAME=vinai/phobert-base-v2
BGE_M3_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=auto

# Cấu hình Điều Phối Tài Nguyên (CPU / GPU / RAM / PyTorch)
CPU_NUM_THREADS=4
EMBEDDING_CHAT_DEVICE=cpu
INDEXING_CPU_BATCH_SIZE=32
INDEXING_GPU_BATCH_SIZE=64
ENABLE_GPU_INDEXING=true
GPU_INDEXING_MIN_RECORDS=300
MIN_VRAM_GPU_INDEXING_MB=3500
STATE_TRANSITION_TIMEOUT=30.0

# Cấu hình RRF & Ngưỡng Lọc Phù Hợp
RRF_K=60
TOP_K_RETRIEVAL=3
FALLBACK_RRF_THRESHOLD=0.005
